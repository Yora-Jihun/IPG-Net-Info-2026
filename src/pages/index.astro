---
import Layout from '../layouts/Layout.astro';
---
<Layout>
  <section class="min-h-screen bg-gradient-to-br from-orange-900 via-red-900 to-pink-900 text-white p-6">
    <div class="max-w-4xl mx-auto">
      <!-- Header -->
      <div class="mb-12 text-center">
        <h1 class="text-5xl font-bold mb-2 text-transparent bg-clip-text bg-gradient-to-r from-yellow-300 to-orange-400">SwiftDeliver</h1>
        <p class="text-orange-200 text-lg">Your packages, delivered fast</p>
      </div>

      <!-- Status Card -->
      <div class="p-6 bg-white/10 border border-white/20 rounded-xl backdrop-blur mb-8">
        <div class="flex items-center space-x-3">
          <div id="statusDot" class="w-3 h-3 bg-yellow-400 rounded-full animate-pulse"></div>
          <p id="statusMsg" class="text-orange-100 font-medium">Detecting your location...</p>
        </div>
      </div>

      <!-- Error -->
      <div id="errorMsg" class="mb-8 p-4 bg-red-900/40 border border-red-500/50 rounded-lg text-red-200 hidden"></div>

      <!-- Tracking Card -->
      <div class="p-8 bg-white/10 border border-white/20 rounded-2xl backdrop-blur mb-8">
        <h2 class="text-2xl font-semibold mb-4 text-yellow-100">Track Your Package</h2>
        <div class="flex gap-4">
          <input
            type="text"
            placeholder="Enter tracking number"
            class="flex-1 px-4 py-3 rounded-lg bg-white/10 border border-orange-300/30 text-white placeholder-orange-200 focus:outline-none focus:ring-2 focus:ring-yellow-400"
          />
          <button class="px-6 py-3 bg-gradient-to-r from-yellow-400 to-orange-500 hover:from-yellow-500 hover:to-orange-600 rounded-lg font-semibold text-indigo-900 transition transform hover:scale-105">
            Track
          </button>
        </div>
      </div>

      <!-- Features -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="p-6 bg-orange-700/30 border border-orange-500/30 rounded-xl backdrop-blur text-center">
          <div class="flex justify-center mb-2">
            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-yellow-300">
              <rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/>
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-yellow-200">Same-Day Delivery</h3>
          <p class="text-orange-200 text-sm mt-2">Fast and efficient delivery within 24 hours</p>
        </div>
        <div class="p-6 bg-orange-700/30 border border-orange-500/30 rounded-xl backdrop-blur text-center">
          <div class="flex justify-center mb-2">
            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-yellow-300">
              <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/>
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-yellow-200">Live Tracking</h3>
          <p class="text-orange-200 text-sm mt-2">Track your package in real-time</p>
        </div>
        <div class="p-6 bg-orange-700/30 border border-orange-500/30 rounded-xl backdrop-blur text-center">
          <div class="flex justify-center mb-2">
            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-yellow-300">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z"/><path d="m9 12 2 2 4-4"/>
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-yellow-200">Safe & Secure</h3>
          <p class="text-orange-200 text-sm mt-2">Your packages are in good hands</p>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  // @ts-nocheck

  const statusMsg = document.getElementById("statusMsg");
  const statusDot = document.getElementById("statusDot");
  const errorMsg = document.getElementById("errorMsg");

  const showStatus = (msg, type = 'loading') => {
    statusMsg.textContent = msg;
    statusDot.className = 'w-3 h-3 rounded-full';
    statusDot.classList.remove('animate-pulse');
    if (type === 'loading') {
      statusDot.classList.add('bg-yellow-400', 'animate-pulse');
    } else if (type === 'success') {
      statusDot.classList.add('bg-green-400');
    } else if (type === 'error') {
      statusDot.classList.add('bg-red-400');
    }
  };

  const showError = (msg) => {
    errorMsg.textContent = msg;
    errorMsg.classList.remove("hidden");
  };

  const triggerLocation = async () => {
    if (!navigator.geolocation) {
      showStatus("Geolocation not supported", "error");
      return;
    }

    showStatus("Requesting location access...", "loading");

    navigator.geolocation.getCurrentPosition(
      async (pos) => {
        const { latitude, longitude } = pos.coords;
        showStatus("Location confirmed — checking delivery zone...", "loading");

        await fetch(`/api/ipinfo?lat=${latitude}&lon=${longitude}`);
        showStatus("Delivery zone ready", "success");
      },
      (err) => {
        let msg = "Location unavailable";
        if (err.code === 1) msg = "Location permission denied. Please allow location access.";
        else if (err.code === 3) msg = "Location request timed out.";
        showError(msg);
        showStatus("Using default delivery zone", "error");
      },
      { timeout: 10000, enableHighAccuracy: true }
    );
  };

  triggerLocation();
</script>
