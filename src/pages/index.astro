---
import Layout from '../layouts/Layout.astro';
---
<Layout>
  <section class="min-h-screen bg-gradient-to-br from-orange-900 via-red-900 to-pink-900 text-white p-6">
    <div class="max-w-4xl mx-auto">
      <!-- Header -->
      <div class="mb-12 text-center">
        <h1 class="text-5xl font-bold mb-2 text-transparent bg-clip-text bg-gradient-to-r from-yellow-300 to-orange-400">Delivery Tracker</h1>
        <p class="text-orange-200 text-lg">Fast & reliable delivery service</p>
      </div>

      <!-- Tracking Card -->
      <div class="p-8 bg-orange-700/40 border border-orange-500/50 rounded-2xl backdrop-blur mb-8">
        <h2 class="text-2xl font-semibold mb-4 text-yellow-100">Track Your Package</h2>
        <div class="flex gap-4">
          <input
            type="text"
            placeholder="Enter tracking number"
            class="flex-1 px-4 py-3 rounded-lg bg-white/10 border border-orange-300/30 text-white placeholder-orange-200 focus:outline-none focus:ring-2 focus:ring-yellow-400"
          />
          <button class="px-6 py-3 bg-gradient-to-r from-yellow-400 to-orange-500 hover:from-yellow-500 hover:to-orange-600 rounded-lg font-semibold text-orange-900 transition transform hover:scale-105">
            Track
          </button>
        </div>
      </div>

      <!-- Status Card -->
      <div class="p-6 bg-orange-700/40 border border-orange-500/50 rounded-xl backdrop-blur mb-8">
        <div class="flex items-center space-x-3">
          <div class="w-3 h-3 bg-yellow-400 rounded-full animate-pulse"></div>
          <p class="text-orange-100 font-medium">Ready to deliver!</p>
        </div>
      </div>

      <!-- Features -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="p-6 bg-orange-700/30 border border-orange-500/30 rounded-xl backdrop-blur text-center">
          <p class="text-3xl mb-2">🛵</p>
          <h3 class="text-lg font-semibold text-yellow-200">Same-Day Delivery</h3>
          <p class="text-orange-200 text-sm mt-2">Fast and efficient delivery within 24 hours</p>
        </div>
        <div class="p-6 bg-orange-700/30 border border-orange-500/30 rounded-xl backdrop-blur text-center">
          <p class="text-3xl mb-2">📍</p>
          <h3 class="text-lg font-semibold text-yellow-200">Live Tracking</h3>
          <p class="text-orange-200 text-sm mt-2">Track your package in real-time</p>
        </div>
        <div class="p-6 bg-orange-700/30 border border-orange-500/30 rounded-xl backdrop-blur text-center">
          <p class="text-3xl mb-2">✅</p>
          <h3 class="text-lg font-semibold text-yellow-200">Safe & Secure</h3>
          <p class="text-orange-200 text-sm mt-2">Your packages are in good hands</p>
        </div>
      </div>
    </div>
  </section>
</Layout>
